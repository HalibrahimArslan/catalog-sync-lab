<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: bağımlılık sürümlerini (AMQP, JDBC, Flyway, Testcontainers...) tek yerden yönetir. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rabbitlab</groupId>
    <artifactId>rabbit-lab</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rabbit-lab :: phase 4 operations</name>

    <!--
        Her bounded context ayrı bir uygulama; birbirlerinin sınıflarını göremezler, tek ortak noktaları
        mesaj sözleşmesi (contract). Faz 3: her context de kendi içinde Onion halkalarına bölünmüş
        (model → domain-service → application → infrastructure); her halka ayrı Maven modülü.
    -->
    <modules>
        <module>contract</module>
        <module>backoffice</module>
        <module>storefront</module>
        <module>acceptance</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <cucumber.version>7.34.9</cucumber.version>
        <archunit.version>1.5.1</archunit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>backoffice-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>backoffice-domain-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>backoffice-domain-service</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>backoffice-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>backoffice-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>storefront-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>storefront-domain-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>storefront-domain-service</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>storefront-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitlab</groupId>
                <artifactId>storefront-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
