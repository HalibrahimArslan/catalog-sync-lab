<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.rabbitlab</groupId>
        <artifactId>backoffice</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>backoffice-domain-service</artifactId>
    <name>rabbit-lab :: backoffice :: domain-service</name>
    <description>
        İkinci halka: domain servisleri ve repository arayüzleri. Tek bir aggregate'in cevaplayamadığı
        kurallar (SKU benzersizliği, ürünle birlikte stok açmak) ve "aggregate'ler kalıcıdır" sözleşmesi.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.rabbitlab</groupId>
            <artifactId>backoffice-model</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Sahte repository'ler (src/test) test-jar olarak yayınlanır; application testleri kullanır. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
